# SDP project config for spark_k8s
# Copy to .sdp/config.yml: cp docs/sdp-config.yml.example .sdp/config.yml
# Or run: sdp init --auto

version: 1

evidence:
  enabled: true
  log_path: ".sdp/log/events.jsonl"

quality:
  max_file_loc: 200
  coverage_exclude:
    - "charts/"
    - "tests/"
    - "scripts/"
    - "docs/"

guard:
  mode: "permissive"
  rules_file: ".sdp/guard-rules.yml"
