{
  "annotations": {"list": []},
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": null,
  "links": [
    {"title": "Spark History Server", "url": "${history_url}", "type": "link"},
    {"title": "Jaeger Traces", "url": "${jaeger_url}", "type": "link"}
  ],
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2},
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "up{job=~\"spark.*history.*\"}", "refId": "A"}],
      "title": "History Server Up",
      "type": "timeseries"
    },
    {
      "datasource": "Loki",
      "fieldConfig": {
        "defaults": {
          "custom": {"displayMode": "list"}
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "{app=~\"spark.*\"}", "refId": "A"}],
      "title": "Spark Logs",
      "type": "logs"
    },
    {
      "datasource": "Jaeger",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "id": 3,
      "title": "Traces",
      "type": "traces"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 27,
  "style": "dark",
  "tags": ["spark", "overview", "observability", "unified"],
  "templating": {
    "list": [
      {
        "name": "history_url",
        "type": "constant",
        "label": "History Server URL",
        "query": "http://localhost:18081",
        "description": "Demo: localhost:18081 (port-forward). Full stack: http://<release>-spark-35-history.<namespace>:18080"
      },
      {
        "name": "jaeger_url",
        "type": "constant",
        "label": "Jaeger UI URL",
        "query": "http://localhost:16686",
        "description": "Set if Jaeger deployed. Demo: not deployed."
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "title": "Spark Overview",
  "uid": "spark-overview",
  "version": 1
}
